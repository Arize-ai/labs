---
// Example MDX component. Import it in a .mdx post to use it.
export interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<aside class="callout">
  {title && <p class="eyebrow">{title}</p>}
  <div class="body"><slot /></div>
</aside>

<style>
  .callout { padding: var(--space-4) var(--space-5); border-left: 2px solid var(--accent); background: var(--placeholder); }
  .eyebrow { margin-bottom: var(--space-2); }
  .body :global(> * + *) { margin-top: 0.75em; }
</style>
