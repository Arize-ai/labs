---
import { tagUrl } from "../lib/content";

export interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul class="tags">
    {tags.map((tag) => <li><a href={tagUrl(tag)}>{tag}</a></li>)}
  </ul>
)}

<style>
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-2); padding: 0; list-style: none; }
  .tags a {
    display: inline-block;
    padding: 4px 8px;
    border: 1px solid var(--rule);
    color: var(--dim);
    font: 500 var(--text-micro) / 1 var(--font-mono);
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
    text-decoration: none;
  }
  .tags a:hover { border-color: var(--fg); color: var(--fg); }
</style>
